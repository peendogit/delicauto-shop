# Kopiraj u .env i popuni. .env NE ide na GitHub.
PORT=3010
SITE_URL=https://delicauto.com

# Veza s aplikacijom za otpad (AutoDelicGume radi na portu 3003)
APP_URL=http://127.0.0.1:3003
# Ostavi PRAZNO dok shop radi iz uvezenog backupa; kad programer da API, upiši ključ
APP_API_KEY=
# Putanja do slika aplikacije (ista VPS mašina). Ako ostane prazno, slike se vuku preko APP_URL/uploads/
UPLOADS_DIR=/root/AutoDelicGume/public/uploads

# Podaci firme koji se prikazuju na sajtu
SHOP_NAME=Auto Otpad Delić
SHOP_CITY=Bijeljina
SHOP_PHONE=066 027 888
SHOP_VIBER=
SHOP_EMAIL=

# Admin (pregled narudžbi i upita): /admin
ADMIN_USER=nino
ADMIN_PASS=PROMIJENI_OVO

# Telegram obavijesti o narudžbama i upitima (nije obavezno)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ostalo (možeš ostaviti)
DATA_DIR=./data
POLL_SECONDS=20

# Uvoz iz backupa (tools/import-dump.js): kako se zove fajl slike. {id} = ID priloga iz baze. Primjeri: {id}.jpg  ili  {p2}/{id}.jpg
IMG_PATTERN={id}.jpg
